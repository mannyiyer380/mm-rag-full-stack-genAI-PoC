# Copy this file to .env and fill in your own values.
#   cp .env.example .env
#
# Do NOT commit .env — it is ignored via .gitignore.
# Paste values carefully: a stray character or a space inside quotes will
# surface later as a confusing 403 or "missing" error rather than a clear one.

# ---------------------------------------------------------------------------
# OpenAI — embeddings and chat completion (required)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Defaults are applied in code if these are unset.
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSION=3072
OPENAI_CHAT_MODEL=gpt-4.1-mini

# ---------------------------------------------------------------------------
# Qdrant — vector store (required)
# ---------------------------------------------------------------------------
# Cluster endpoint from the Qdrant Cloud console. No trailing slash, no quotes.
QDRANT_URL=https://your-cluster-id.us-east-2-0.aws.cloud.qdrant.io

# Qdrant Cloud API key. This is a JWT and begins with "eyJ".
QDRANT_API_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxx

QDRANT_COLLECTION_NAME=mm-rag-documents

# ---------------------------------------------------------------------------
# Tesseract OCR (optional)
# ---------------------------------------------------------------------------
# Only needed if the tesseract binary is not on your PATH.
# macOS (Homebrew): /opt/homebrew/bin/tesseract
# Windows:          C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_PATH=
